<Application x:Class="FencesVE.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!--
            Pedzle motywu sa nadpisywane w czasie dzialania przez ThemeService.
            Te wartosci sa tylko awaryjnym domyslnym zestawem.
        -->
        <SolidColorBrush x:Key="FenceBackgroundBrush" Color="#8C101418" />
        <SolidColorBrush x:Key="FenceHeaderBrush" Color="#B30C0F12" />
        <SolidColorBrush x:Key="FenceTextBrush" Color="#F2F4F7" />
        <SolidColorBrush x:Key="FenceHoverBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="FenceSelectionBrush" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="FenceBorderBrush" Color="#29FFFFFF" />
    </Application.Resources>
</Application>
