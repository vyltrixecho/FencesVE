<Window x:Class="FencesVE.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FencesVE.Views"
        Title="{v:Loc Settings_Title}"
        Width="480"
        Height="570"
        MinWidth="440"
        MinHeight="490"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--
          Checkboxy nie maja tu wlasnego stylu i nie moga go dostac. Styl zdefiniowany
          w tym oknie - implicit czy keyed - w obu przypadkach odcielby je od szablonu
          z DarkTheme.xaml: implicit przeslania slownik scalony, a jawnie ustawiony styl
          zastepuje styl domyslny w calosci. Odstep idzie wiec wprost na kontrolkach.
        -->

        <!-- Banner zachowuje sie jak link: przygasa, dopoki nie najedziesz kursorem. -->
        <Style TargetType="Border" x:Key="BannerLink">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="2" />
            <!-- Tlo dokladnie takie jak w bitmapie, zeby margines nie odcinal sie od grafiki. -->
            <Setter Property="Background" Value="#000000" />
            <Setter Property="BorderBrush" Value="#66E8C468" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E8C468" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">

            <!--
              Padding w pionie jest dobrany tak, zeby kafelek mial dokladnie tyle, co kod QR
              obok: 64 px grafiki + 2x11 px oddechu + 2x1 px ramki = 88 px. Inaczej jeden
              z nich wystaje ponad drugi.
            -->
            <Border DockPanel.Dock="Left" Style="{StaticResource BannerLink}"
                    Padding="12,11" VerticalAlignment="Center"
                    ToolTip="{v:Loc Settings_BannerTip}"
                    MouseLeftButtonUp="VyltrixBanner_Click">
                <Image Source="pack://application:,,,/Assets/VyltrixEcho.png"
                       Height="64" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!--
              QR to 33 moduly plus otulina, czyli 41 modulow na bok. Przy 88 px wychodzi
              nieco ponad 2 px na modul - tyle aparat telefonu jeszcze odczyta z ekranu,
              ale nizej juz nie schodzic. Tlo musi zostac biale: ciemna otulina psuje odczyt.
            -->
            <Border DockPanel.Dock="Right" CornerRadius="2" Background="White"
                    VerticalAlignment="Center" Cursor="Hand"
                    ToolTip="{v:Loc Settings_QrTip}"
                    MouseLeftButtonUp="BuyCoffeeButton_Click">
                <Image Source="pack://application:,,,/Assets/BuyCoffeeQr.png"
                       Width="88" Height="88"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1">

            <TabItem Header="{v:Loc Tab_Appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="{v:Loc Settings_Theme}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="{v:Loc Theme_Dark}" />
                            <ComboBoxItem Content="{v:Loc Theme_Light}" />
                        </ComboBox>

                        <TextBlock Text="{v:Loc Settings_Language}" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="{v:Loc Language_System}" />
                            <ComboBoxItem Content="{v:Loc Language_Polish}" />
                            <ComboBoxItem Content="{v:Loc Language_English}" />
                        </ComboBox>
                        <TextBlock Text="{v:Loc Settings_LanguageHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                        <TextBlock Text="{v:Loc Settings_FenceColor}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ColorPreview"
                                    Width="34" Height="26"
                                    BorderBrush="#40000000" BorderThickness="1"
                                    CornerRadius="2" Margin="0,0,8,0" />
                            <Button x:Name="PickColorButton" Content="{v:Loc Settings_PickColor}" Width="140" Height="26"
                                    Margin="0,0,8,0" Click="PickColorButton_Click" />
                            <Button x:Name="EyedropAccentButton" Content="{v:Loc Settings_EyedropScreen}" Width="120" Height="26"
                                    ToolTip="{v:Loc Settings_EyedropTip}"
                                    Click="EyedropAccentButton_Click" />
                        </StackPanel>

                        <TextBlock Text="{v:Loc Settings_TextColor}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="TextColorPreview"
                                    Width="34" Height="26"
                                    BorderBrush="#40000000" BorderThickness="1"
                                    CornerRadius="2" Margin="0,0,8,0" />
                            <Button x:Name="PickTextColorButton" Content="{v:Loc Settings_PickColor}" Width="140" Height="26"
                                    Margin="0,0,8,0" Click="PickTextColorButton_Click" />
                            <Button x:Name="EyedropTextButton" Content="{v:Loc Settings_Eyedrop}" Width="80" Height="26"
                                    Margin="0,0,8,0"
                                    ToolTip="{v:Loc Settings_EyedropTip}"
                                    Click="EyedropTextButton_Click" />
                            <Button x:Name="ResetTextColorButton" Content="{v:Loc Settings_ByTheme}" Width="100" Height="26"
                                    Click="ResetTextColorButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="FontSizeLabel" Text="{v:Loc Settings_FontSize}" Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="24" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="FontSizeSlider_ValueChanged" />

                        <TextBlock x:Name="HeaderHeightLabel" Text="{v:Loc Settings_HeaderHeight}"
                                   Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="HeaderHeightSlider" Minimum="18" Maximum="72" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="HeaderHeightSlider_ValueChanged" />
                        <TextBlock Text="{v:Loc Settings_HeaderHeightHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                        <TextBlock Text="{v:Loc Settings_HeaderSide}" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="HeaderSideCombo" SelectionChanged="HeaderSideCombo_SelectionChanged">
                            <ComboBoxItem Content="{v:Loc SideLower_Top}" />
                            <ComboBoxItem Content="{v:Loc Side_Bottom}" />
                            <ComboBoxItem Content="{v:Loc SideLower_Left}" />
                            <ComboBoxItem Content="{v:Loc SideLower_Right}" />
                        </ComboBox>
                        <TextBlock Text="{v:Loc Settings_HeaderSideHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                        <TextBlock Text="{v:Loc Settings_TitleAlignment}" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="TitleAlignmentCombo" SelectionChanged="TitleAlignmentCombo_SelectionChanged">
                            <ComboBoxItem Content="{v:Loc Align_Left}" />
                            <ComboBoxItem Content="{v:Loc Align_Center}" />
                            <ComboBoxItem Content="{v:Loc Align_Right}" />
                        </ComboBox>
                        <TextBlock Text="{v:Loc Settings_TitleAlignmentHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                        <TextBlock x:Name="OpacityLabel" Text="{v:Loc Settings_Opacity}" Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="1.0" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />

                        <TextBlock x:Name="RadiusLabel" Text="{v:Loc Settings_CornerRadius}" Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="RadiusSlider" Minimum="0" Maximum="24" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="RadiusSlider_ValueChanged" />

                        <TextBlock x:Name="IconSizeLabel" Text="{v:Loc Settings_IconSize}" Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="IconSizeSlider" Minimum="24" Maximum="128" TickFrequency="4"
                                IsSnapToTickEnabled="True" ValueChanged="IconSizeSlider_ValueChanged" />

                        <CheckBox x:Name="ShowLabelsCheck" Margin="0,6,0,0" Content="{v:Loc Settings_ShowLabels}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />

                        <TextBlock x:Name="PeekLabel" Text="{v:Loc Settings_Peek}"
                                   Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="PeekSlider" Minimum="2" Maximum="40" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="PeekSlider_ValueChanged" />
                        <TextBlock Text="{v:Loc Settings_PeekHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                        <CheckBox x:Name="PeekShowsHeaderCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_PeekShowsHeader}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock Text="{v:Loc Settings_PeekShowsHeaderHint}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="24,2,0,0" FontSize="11" />

                        <TextBlock x:Name="AutoHideLabel" Text="{v:Loc Settings_AutoHide}"
                                   Style="{StaticResource SectionLabel}" />
                        <Slider x:Name="AutoHideSlider" Minimum="100" Maximum="3000" TickFrequency="50"
                                IsSnapToTickEnabled="True" ValueChanged="AutoHideSlider_ValueChanged" />
                        <TextBlock Text="{v:Loc Settings_AutoHideHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{v:Loc Tab_Behavior}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <CheckBox x:Name="HideDesktopIconsCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_HideDesktopIcons}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock Text="{v:Loc Settings_HideDesktopIconsHint}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="24,2,0,0" FontSize="11" />

                        <CheckBox x:Name="LockFencesCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_LockFences}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />

                        <CheckBox x:Name="AutoSortCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_AutoSort}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />

                        <CheckBox x:Name="StartupCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_RunAtStartup}"
                                  Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" />

                        <CheckBox x:Name="TrayIconCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_ShowTrayIcon}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock Text="{v:Loc Settings_ShowTrayIconHint}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="24,2,0,0" FontSize="11" />

                        <CheckBox x:Name="DesktopMenuCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_DesktopMenu}"
                                  Checked="DesktopMenuCheck_Changed" Unchecked="DesktopMenuCheck_Changed" />
                        <TextBlock Text="{v:Loc Settings_DesktopMenuHint}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="24,2,0,0" FontSize="11" />

                        <CheckBox x:Name="MoveIntoFenceCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_MoveIntoFence}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock Text="{v:Loc Settings_MoveIntoFenceHint}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="24,2,0,0" FontSize="11" />

                        <CheckBox x:Name="DesktopDoubleClickCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_DesktopDoubleClick}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock Text="{v:Loc Settings_DesktopDoubleClickHint}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="24,2,0,0" FontSize="11" />

                        <TextBlock Text="{v:Loc Settings_DesktopGroup}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ImportButton" Content="{v:Loc Settings_Import}"
                                    Width="200" Height="28" Margin="0,0,8,0" Click="ImportButton_Click" />
                            <Button x:Name="NewFenceButton" Content="{v:Loc Settings_NewFence}"
                                    Width="120" Height="28" Click="NewFenceButton_Click" />
                        </StackPanel>

                        <TextBlock Text="{v:Loc Settings_LayoutFile}" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="LayoutPathBox" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="Transparent" BorderThickness="0" Opacity="0.75" FontSize="11" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{v:Loc Tab_Updates}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock x:Name="VersionLabel" Text="{v:Loc Settings_Version}" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{v:Loc Settings_FeedUrl}" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="FeedUrlBox" Padding="4,3" LostFocus="FeedUrlBox_LostFocus" />
                        <TextBlock Text="{v:Loc Settings_FeedHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,2,0,0" />

                        <CheckBox x:Name="CheckOnStartupCheck" Margin="0,6,0,0"
                                  Content="{v:Loc Settings_CheckOnStartup}"
                                  Checked="CheckOnStartup_Changed" Unchecked="CheckOnStartup_Changed" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="CheckUpdatesButton" Content="{v:Loc Settings_CheckNow}" Width="140" Height="28"
                                    Margin="0,0,8,0" Click="CheckUpdatesButton_Click" />
                            <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Opacity="0.8" />
                        </StackPanel>

                        <TextBlock Text="{v:Loc Settings_ManifestFormat}" Style="{StaticResource SectionLabel}" />
                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11" Opacity="0.8"
                                 Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                 Text="{}{&#10;  &quot;version&quot;: &quot;0.4.0&quot;,&#10;  &quot;url&quot;: &quot;https://.../FencesVE.exe&quot;,&#10;  &quot;sha256&quot;: &quot;ABC123...&quot;,&#10;  &quot;notes&quot;: &quot;Co nowego&quot;&#10;}" />

                        <TextBlock Text="{v:Loc Settings_UpdateHint}"
                                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,10,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{v:Loc Tab_Rules}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{v:Loc Settings_Fence}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <!--
                      Jawny ItemTemplate zamiast DisplayMemberPath: pole zwiniete rysuje
                      ContentPresenter po SelectionBoxItemTemplate, a ten bierze sie
                      z ItemTemplate. Przy samym DisplayMemberPath zwinieta lista
                      pokazywala ToString() modelu.
                    -->
                    <ComboBox Grid.Row="1" x:Name="FenceCombo"
                              SelectionChanged="FenceCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ListBox Grid.Row="2" x:Name="RulesList" Margin="0,10,0,0" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox x:Name="RuleKindCombo" Width="150" Margin="0,0,6,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="RulePatternBox" Width="160" Margin="0,0,6,0" Padding="3,2"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="AddRuleButton" Content="{v:Loc Settings_Add}" Width="70" Height="24"
                                Click="AddRuleButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RemoveRuleButton" Content="{v:Loc Settings_RemoveRule}"
                                Width="180" Height="26" Margin="0,0,8,0" Click="RemoveRuleButton_Click" />
                        <Button x:Name="ApplyRulesButton" Content="{v:Loc Settings_ApplyNow}"
                                Width="140" Height="26" Click="ApplyRulesButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">

            <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="{v:Loc Settings_Close}"
                    Width="90" Height="28" Click="CloseButton_Click" />

            <!--
              Oficjalny przycisk buycoffee.to. Bitmapa jest w zasobach, a nie ciagnieta
              z sieci - okno ustawien ma sie otwierac tak samo bez internetu.
            -->
            <Image DockPanel.Dock="Left" x:Name="BuyCoffeeButton"
                   Source="pack://application:,,,/Assets/BuyCoffee.png"
                   Height="35" Stretch="Uniform"
                   VerticalAlignment="Center" Cursor="Hand"
                   ToolTip="{v:Loc Settings_CoffeeTip}"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonUp="BuyCoffeeButton_Click" />
        </DockPanel>
    </Grid>
</Window>
