<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FencesVE</AssemblyName>
    <RootNamespace>FencesVE</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FencesVE.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Polski jest jezykiem neutralnym - jego napisy siedza wprost w zestawie, bez satelity.
      Angielski dochodzi jako jedyny zestaw satelicki (stad ta sama lista jezykow ponizej,
      ktora przy okazji odchudza satelity z zaleznosci).
    -->
    <NeutralLanguage>pl</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      WFO0003: analizator WinForms chce konfiguracji DPI przez ApplicationHighDpiMode.
      To jest przede wszystkim aplikacja WPF - PerMonitorV2 w manifescie jest tu poprawne.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms dorzuca globalne usingi System.Windows.Forms i System.Drawing,
      ktore koliduja z WPF (Application, Color, Point, MenuItem, TextBox...).
      Usuwamy je - WinForms jest tu potrzebny tylko do NotifyIcon i dwoch dialogow,
      wiec te miejsca importuja go jawnie.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ta sama ikona co w zasobach .exe, ale osadzona w zestawie - zasobnik
      moze wtedy poprosic o dokladnie ten rozmiar, ktorego potrzebuje przy
      biezacym DPI, zamiast skalowac jeden gotowy obrazek.
    -->
    <EmbeddedResource Include="Assets\FencesVE.ico" />

    <!-- Banner w stopce okna ustawien - ladowany przez pack URI, wiec musi byc Resource. -->
    <Resource Include="Assets\VyltrixEcho.png" />
    <Resource Include="Assets\BuyCoffee.png" />
    <Resource Include="Assets\BuyCoffeeQr.png" />
  </ItemGroup>

</Project>
